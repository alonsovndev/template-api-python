APP_ENV=local
PERSISTENCE_DRIVER=memory
APP_NAME=template-api-python
LOG_LEVEL=INFO
# Set these for PostgreSQL; choose your own local password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=
# Optional: managed databases and cross-origin browsers.
# POSTGRES_SSL_MODE=require   # disable | require | verify-full
# POSTGRES_POOL_MODE=queue    # use null behind a transaction-mode pooler
# CORS_ALLOWED_ORIGINS=https://app.example.com
